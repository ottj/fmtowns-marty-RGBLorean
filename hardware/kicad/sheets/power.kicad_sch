	(text "Power tree (concept phase):\n  +5V_IN (from PCMCIA pins 17/51 via parent)\n    -> D1 (reverse-polarity Schottky, optional — short with 0R if unwanted)\n    -> +5V rail (decoupled with C1 22uF + C2 100nF)\n    -> U_REG1 (AMS1117-3.3, SOT-223): +3V3 rail (C3 22uF + C4 100nF + LED indicator)\n         -> consumed by FPGA I/O, level shifters U_LS1..4, ADV7513 digital, ADV7123, SD card\n    -> U_REG2 (TLV1117-1.1 or buck, SOT-223): +1V1 rail (C5 22uF + C6 100nF)\n         -> consumed by ECP5 VCCINT (core)\n\nDeferred: +1V8 (ADV7513 PLL analog), +2V5 (HDMI termination), SDRAM rail if external."
		(exclude_from_sim no)
		(at 20 200 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "70000000-0000-0000-0000-000000000001")
	)
