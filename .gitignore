# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*-cache*
*-bak
*-bak*
*~
~*
_autosave-*
\#auto_saved_files\#
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
\#auto_saved_files#

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv

# Archived Backups (KiCad 6.0)
**/*-backups/*.zip

# Local git-based history (KiCad 9.0+)
.history

# Local project settings
*.kicad_prl

# KiCad fabrication outputs (regenerable)
hardware/kicad/outputs/

# FPGA build artefacts
firmware/fpga/build/
*.bit
*.cfg
*.fasm

# Marty Bios files
firmware/marty

# x86 build artefacts
firmware/x86/**/*.bin
firmware/x86/**/*.o
firmware/x86/**/*.lst
firmware/x86/**/*.map

# Python
__pycache__/
*.pyc
.venv/

# OS
.DS_Store
